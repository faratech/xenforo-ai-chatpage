# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/dist
/build

# misc
.DS_Store
# Local env files are never tracked. `.env` currently holds only public
# values (see .env.example), but untracking it keeps a future edit from
# committing purge-token-class secrets by accident.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Playwright MCP session artifacts (snapshots, console logs)
.playwright-mcp/

# Playwright screenshots taken during debugging
*.png
!public/pwa-icon-192.png
!public/pwa-icon-512.png
