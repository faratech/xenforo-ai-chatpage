.react-App {
    height: 50vh;
    display: flex;
    flex-direction: column;
    max-height: 80vh;
}

.react-message {
    display: flex;
    margin-bottom: 10px;
    align-items: flex-start;
    max-width: 100%;
}

.react-message img {
    width: 40px; /* Static size */
    height: 40px; /* Static size */
    border-radius: 50%;
    margin-right: 10px;
}

.react-message-wrapper {
    padding: 10px;
    border-radius: 5px;
    max-width: 80%;
    word-wrap: break-word;
}

.react-username {
    font-weight: bold;
    margin-bottom: 5px;
}

#react-chat-window {
    flex: 1;
    overflow-y: auto;
    padding: 10px;
}

#react-user-input {
    flex: 1;
    padding: 10px;
    border-radius: 5px;
    border: 1px solid #ccc;
    margin-right: 10px;
    width: calc(100% - 120px);
}

.button--primary {
    padding: 10px 20px;
    border-radius: 5px;
    background: #0073e6;
    color: #fff;
    border: none;
    cursor: pointer;
    width: 100px;
}

@media (max-width: 600px) {
    .react-message-wrapper {
        max-width: 100%;
    }

    #react-user-input {
        width: calc(100% - 120px);
    }

    .button--primary {
        width: 80px;
    }
}
