import React, { useState, useEffect, useCallback, useRef } from 'react';
import { ChakraProvider, Box, Button, Textarea, VStack, HStack, Avatar, Text, extendTheme, useColorModeValue } from '@chakra-ui/react';
import { marked } from 'marked';
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import { faMicrophone, faMicrophoneSlash } from '@fortawesome/free-solid-svg-icons';
import './App.css';

const domain = window.location.hostname === 'test.windowsforum.com' ? 'https://test.windowsforum.com' : 'https://windowsforum.com';
const dataDomain = 'https://data.windowsforum.com';
const apiDomain = 'https://ai.windowsforum.com';
const LOCAL_STORAGE_KEY = 'chatMessages';

const Message = ({ msg, userAvatar, userName }) => {
    const bgColor = useColorModeValue('blue.500', 'gray.700');
    return (
        <Box mb={4}>
            <HStack align="start">
                <Avatar src={msg.role === 'user' ? userAvatar : `${dataDomain}/avatars/l/125/125694.jpg?1717034184`} />
                <Box bg={msg.role === 'user' ? 'blue.500' : bgColor} color="white" p={3} borderRadius="md" maxWidth="70%">
                    <Text fontWeight="bold" mb={2}>{msg.role === 'user' ? userName : 'AI Bot'}</Text>
                    <Box dangerouslySetInnerHTML={{ __html: msg.content }} />
                </Box>
            </HStack>
        </Box>
    );
};

const ChatWindow = ({ userAvatar, userName }) => {
    const [messages, setMessages] = useState([]);
    const [input, setInput] = useState('');
    const [isListening, setIsListening] = useState(false);
    const [speechRecognition, setSpeechRecognition] = useState(null);
    const chatWindowRef = useRef(null);

    const scrollToBottom = () => {
        if (chatWindowRef.current) {
            chatWindowRef.current.scrollTop = chatWindowRef.current.scrollHeight;
        }
    };

    useEffect(() => {
        const storedMessages = JSON.parse(localStorage.getItem(LOCAL_STORAGE_KEY)) || [];
        setMessages(storedMessages);
        scrollToBottom();
    }, []);

    useEffect(() => {
        localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(messages));
        scrollToBottom();
    }, [messages]);

    const playAudioResponse = useCallback(async (text) => {
        try {
            const response = await fetch(`${apiDomain}/tts`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text })
            });
            const audioBlob = await response.blob();
            const audioUrl = URL.createObjectURL(audioBlob);
            const audio = new Audio(audioUrl);
            audio.play();
        } catch (error) {
            console.error('Error fetching TTS:', error);
        }
    }, []);

    const handleSendMessage = async () => {
        if (!input.trim()) return;

        const messageContent = input.trim();

        if (messageContent.toLowerCase() === '/clear') {
            setMessages([]); // Clear messages in the frontend
            localStorage.removeItem(LOCAL_STORAGE_KEY); // Clear messages in local storage
            setInput(''); // Clear the input field
            return;
        }

        const newMessage = { role: 'user', content: marked(messageContent) };
        setMessages(prevMessages => [...prevMessages, newMessage]);
        setInput('');

        try {
            const response = await fetch(`${domain}/chat.php`, {
                method: 'POST',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: messageContent })
            });

            if (!response.body) throw new Error('ReadableStream not supported');

            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            let done = false;
            let aiMessage = '';
            const newAiMessage = { role: 'ai', content: '' };
            setMessages(prevMessages => [...prevMessages, newAiMessage]);

            const processChunk = (value) => {
                const chunk = decoder.decode(value, { stream: true });
                const lines = chunk.split('\n');

                lines.forEach(line => {
                    if (line.startsWith('data: ')) {
                        try {
                            const parsedData = JSON.parse(line.substring(6));
                            if (parsedData.type === 'text' && parsedData.text && parsedData.text.value) {
                                aiMessage += parsedData.text.value;
                                setMessages(prevMessages => {
                                    const updatedMessages = [...prevMessages];
                                    const lastMessage = updatedMessages[updatedMessages.length - 1];
                                    if (lastMessage && lastMessage.role === 'ai') {
                                        lastMessage.content = marked(aiMessage); // Parse Markdown
                                    }
                                    return updatedMessages;
                                });
                                scrollToBottom();
                            } else if (parsedData.thread_id) {
                                console.log(`Thread ID: ${parsedData.thread_id}`);
                            }
                        } catch (error) {
                            console.error('Error parsing streaming data:', error);
                        }
                    }
                });
            };

            while (!done) {
                const { value, done: streamDone } = await reader.read();
                done = streamDone;
                if (value) processChunk(value);
            }

            playAudioResponse(aiMessage); // Automatically play TTS after receiving the response
        } catch (error) {
            console.error('Error sending message:', error);
        }
    };

    const handleStartListening = useCallback(() => {
        if (speechRecognition) {
            speechRecognition.start();
            setIsListening(true);
        }
    }, [speechRecognition]);

    const handleStopListening = useCallback(() => {
        if (speechRecognition) {
            speechRecognition.stop();
            setIsListening(false);
        }
    }, [speechRecognition]);

    useEffect(() => {
        if (window.SpeechRecognition || window.webkitSpeechRecognition) {
            const recognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            const speech = new recognition();
            speech.interimResults = true;
            speech.lang = 'en-US';
            speech.onresult = (event) => {
                const transcript = Array.from(event.results)
                    .map(result => result[0])
                    .map(result => result.transcript)
                    .join('');
                setInput(transcript);
            };
            setSpeechRecognition(speech);
        }
    }, []);

    useEffect(() => {
        const initialMessages = [
            { role: 'ai', content: marked('Welcome to WindowsForum.com! Feel free to ask me anything about Windows or technology!') }
        ];
        setMessages(initialMessages);
    }, []);

    return (
        <Box id="react-chat-container" borderRadius="md" bg={useColorModeValue('#f0f0f0', '#1e1e1e')} border="1px solid" borderColor={useColorModeValue('#ccc', '#333')} boxShadow="md" height="100vh" width="100%" maxWidth="100%" mx="auto" display="flex" flexDirection="column">
            <VStack ref={chatWindowRef} overflowY="auto" flex="1" p={4} spacing={4}>
                {messages.map((msg, index) => (
                    <Message key={index} msg={msg} userAvatar={userAvatar} userName={userName} />
                ))}
            </VStack>
            <HStack p={4} borderTop="1px solid" borderColor={useColorModeValue('#ccc', '#333')}>
                <Textarea
                    value={input}
                    onChange={(e) => setInput(e.target.value)}
                    placeholder="Type your message here..."
                    flex="1"
                    bg={useColorModeValue('#fff', '#1e1e1e')}
                    color={useColorModeValue('#000', '#e0e0e0')}
                    border="1px solid"
                    borderColor={useColorModeValue('#ccc', '#333')}
                    className="input-area"
                />
                <Button onClick={handleSendMessage} colorScheme="blue">
                    Send
                </Button>
                <Button onClick={isListening ? handleStopListening : handleStartListening} ml={2}>
                    <FontAwesomeIcon icon={isListening ? faMicrophoneSlash : faMicrophone} />
                </Button>
            </HStack>
        </Box>
    );
};

const App = () => {
    const [userAvatar, setUserAvatar] = useState(`${domain}/images/default-avatar.webp`);
    const [userName, setUserName] = useState('Guest');

    const detectColorScheme = () => (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) ? 'light' : 'dark';

    const [colorMode, setColorMode] = useState(detectColorScheme());

    useEffect(() => {
        const applyColorScheme = (scheme) => {
            document.documentElement.setAttribute('data-theme', scheme);
        };

        applyColorScheme(colorMode);

        const colorSchemeListener = (event) => {
            const newColorScheme = event.matches ? 'dark' : 'light';
            setColorMode(newColorScheme);
            applyColorScheme(newColorScheme);
        };

        const darkModeMediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
        darkModeMediaQuery.addEventListener('change', colorSchemeListener);

        return () => {
            darkModeMediaQuery.removeEventListener('change', colorSchemeListener);
        };
    }, [colorMode]);

    const theme = extendTheme({
        config: {
            initialColorMode: colorMode,
            useSystemColorMode: true,
        },
    });

    useEffect(() => {
        const fetchUserData = async () => {
            try {
                const response = await fetch(`${domain}/chat.php`, {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'getUserData' })
                });
                const data = await response.json();
                if (data.avatar) setUserAvatar(data.avatar);
                if (data.name) setUserName(data.name);
            } catch (error) {
                console.error('Error fetching user data:', error);
            }
        };
        fetchUserData();
    }, []);

    return (
        <ChakraProvider theme={theme}>
            <ChatWindow userAvatar={userAvatar} userName={userName} />
        </ChakraProvider>
    );
};

export default App;
