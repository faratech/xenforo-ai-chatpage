[Unit]
Description=Prune inactive WindowsForum AI chat conversations
After=network-online.target mariadb.service aiapi.service
Wants=network-online.target
ConditionPathExists=/web/xenforo-ai-chatpage/scripts/prune-conversations.php
ConditionPathExists=/web/xenforo-ai-chatpage/scripts/prune-chat-product-data.php

[Service]
Type=oneshot
User=root
WorkingDirectory=/web/xenforo-ai-chatpage
ExecStart=/usr/local/bin/php /web/xenforo-ai-chatpage/scripts/prune-conversations.php --days=30 --limit=25 --apply
ExecStart=/usr/local/bin/php /web/xenforo-ai-chatpage/scripts/prune-chat-product-data.php --file-limit=500 --row-limit=20000 --feedback-days=365 --event-days=90 --pending-minutes=60 --apply
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
