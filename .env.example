# XenForo AI Chat Page - Environment Variables Template
# Copy this file to .env and fill in your values

# Domain Configuration
VITE_DOMAIN=https://windowsforum.com
VITE_TEST_DOMAIN=https://test.windowsforum.com

# Optional API base. Leave empty for same-origin requests (recommended).
# It may be an absolute origin or a root-relative path such as /api-proxy.
VITE_API_BASE=

# Cloudflare Turnstile (CAPTCHA)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Feature Flags
VITE_ENABLE_VOICE=true
VITE_ENABLE_FEEDBACK=true
VITE_MAX_CONVERSATIONS=50
